#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="config/selfhosted.yaml config/.env donetick.db" # donetick.db is kept only if upgrade from "0.1.80~ynh1" or below as this file should not be here after migration to PSQL.

chmod +x "$install_dir/donetick"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Managing tasks and chores" --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# MIGRATE DATABASE (once after 0.1.80~ynh1)
#=================================================

if ynh_app_upgrading_from_version_before_or_equal_to "0.1.80~ynh1"; then
    # Give it a moment so that database schema is fully created at service start
    sleep 1
    _migrate_sqlite_to_psql
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
